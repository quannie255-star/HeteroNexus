<Slide style={{ width: 1280, height: 720, padding: 0, position: 'relative', background: 'linear-gradient(135deg, #0E3F8C 0%, #1E4FA8 100%)', fontFamily: '"Source Han Sans SC","Noto Sans SC","Microsoft YaHei",sans-serif' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, opacity: 0.10 }}>
