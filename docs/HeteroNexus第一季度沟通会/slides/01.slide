<Slide style={{ width: 1280, height: 720, padding: 0, position: 'relative', background: 'linear-gradient(135deg, #0E3F8C 0%, #1E4FA8 100%)', fontFamily: '"Source Han Sans SC","Noto Sans SC","Microsoft YaHei",sans-serif' }}>
    {/* L1 主视觉：异构算力拓扑抽象（结构化 SVG，全篇统一视觉类型） */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720, opacity: 0.13 }}>
        <svg width={1280} height={720} viewBox='0 0 1280 720'>
            <g stroke='#FFFFFF' strokeWidth='1.5' fill='none'>
                <path d='M150 130 L400 250 L690 170 L960 300 L1190 190' />
                <path d='M150 130 L290 440 L610 560 L960 300' />
                <path d='M400 250 L290 440' />
                <path d='M690 170 L610 560' />
                <path d='M960 300 L610 560' />
                <path d='M150 130 L610 560' />
                <path d='M400 250 L960 300' />
            </g>
            <g fill='#FFFFFF'>
                <circle cx='150' cy='130' r='9' />
                <circle cx='400' cy='250' r='12' />
                <circle cx='690' cy='170' r='9' />
                <circle cx='960' cy='300' r='14' />
                <circle cx='1190' cy='190' r='8' />
                <circle cx='290' cy='440' r='10' />
                <circle cx='610' cy='560' r='12' />
            </g>
        </svg>
    </Box>

    <Box style={{ position: 'relative', zIndex: 1, width: 1280, height: 720, padding: '0 88px', flexDirection: 'column', justifyContent: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 26 }}>
            <Box style={{ width: 46, height: 3, background: '#FFC107' }} />
            <Text style={{ fontSize: 20, color: '#BFD3EE', letterSpacing: 1 }}>2026 年中国人民大学「大学生创业训练计划」</Text>
        </Box>

        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#BFD3EE', fontFamily: '"Source Han Serif SC", Georgia, serif', lineHeight: 1.3, marginBottom: 18 }}>
            HeteroNexus: A Multi-Objective Deep Reinforcement Learning
            <br />
            Scheduling Platform for Heterogeneous Computing Clusters
        </Text>

        <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2, marginBottom: 24 }}>
            面向深度学习训练的
            <br />
            异构算力协同调度平台
        </Text>

        <Box style={{ width: 168, height: 5, background: '#FFC107', marginBottom: 26 }} />

        <Text style={{ fontSize: 24, color: '#E8EFF8', lineHeight: 1.5, marginBottom: 40 }}>
            第一季度项目沟通会 · 汇报材料 v1.0
        </Text>

        <Box style={{ flexDirection: 'row', gap: 56 }}>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 14, color: '#8FB4E0' }}>项目负责人</Text>
                <Text style={{ fontSize: 20, color: '#FFFFFF', fontWeight: 'bold' }}>聂权 · 统计学院</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 14, color: '#8FB4E0' }}>项目周期</Text>
                <Text style={{ fontSize: 20, color: '#FFFFFF', fontWeight: 'bold' }}>2026.06 — 2027.05</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 14, color: '#8FB4E0' }}>汇报时间</Text>
                <Text style={{ fontSize: 20, color: '#FFFFFF', fontWeight: 'bold' }}>2026 年 9 月</Text>
            </Box>
        </Box>
    </Box>
</Slide>
